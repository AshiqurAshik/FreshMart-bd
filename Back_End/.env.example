# Core Environment Settings
NODE_ENV=production                   # Node.js environment (development | production)
NODE_DB_ENV=production                # Database environment mode
PORT=5001                             # Port for local backend HTTP server

# Authentication & Security
JWT_BEARER_SECRET="your_secure_jwt_bearer_secret_at_least_32_chars"
JWT_REFRESH_SECRET="your_secure_jwt_refresh_secret_at_least_32_chars"
COOKIE_SECRET="your_secure_cookie_parser_secret_key_2026"
JWT_TTL=31536000                      # Token time to live in seconds (default: 1 year)

# CORS & Frontend URLs
FRONTEND_URL="https://your-frontend-domain.vercel.app"
CORS_ORIGINS="https://your-frontend-domain.vercel.app,http://localhost:3000"

# Database Configuration (PostgreSQL)
# Option 1: Managed Cloud DB URI (Neon / Supabase / Vercel Postgres / Railway) - RECOMMENDED
DATABASE_URL="postgresql://user:password@host-or-neon-pooler.tech:5432/freshmart_db?sslmode=require"
# POSTGRES_URL=                       # Automatically provided if using Vercel Postgres

# Option 2: Individual Connection Parameters
DB_CLIENT="postgres"
DB_HOST="localhost"
DB_PORT="5432"
DB_DATABASE="FreshMart_DB"
DB_USER="postgres"
DB_PASSWORD="your_database_password"
DB_SSL=true                           # Set to true for cloud-hosted databases (Neon/Supabase)

# Redis Configuration (Optional / Upstash Redis for serverless)
REDIS_URL="rediss://default:your-upstash-password@your-upstash-host:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=

# Email Server Configuration (Optional)
MAILER_HOST="smtp.gmail.com"
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER="your-email@gmail.com"
MAILER_PASSWORD="your-app-password"
MAILER_FROM="FreshMart BD <noreply@freshmartbd.com>"

# Auth Server (Optional / OAuth2 / OIDC)
AUTH_SERVER_ISSUER="http://localhost:9000"
AUTH_SERVER_JWKS_URI="http://localhost:9000/oauth2/jwks"
# AUTH_SERVER_AUDIENCE=
